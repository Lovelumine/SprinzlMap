# Flask
APP_SECRET_KEY=change_this_session_secret
SESSION_COOKIE_SECURE=0

# LLM provider. DEEPSEEK_* also support OpenAI-compatible gateways.
LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=replace_with_your_key

# Optional MiMo provider
# LLM_PROVIDER=mimo
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_MODEL=mimo-v2.6-pro
# MIMO_API_KEY=replace_with_your_key

# Optional MySQL persistence and gold curation
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=sprinzlmap
# MYSQL_PASSWORD=replace_me
# MYSQL_DATABASE=sprinzlmap
# MYSQL_CHARSET=utf8mb4

# Optional MinIO/S3 run storage
# MINIO_ENDPOINT=http://127.0.0.1:9000
# MINIO_BUCKET=llm-trnaalign-artifacts
# MINIO_PREFIX=sprinzlmap
# AWS_ACCESS_KEY_ID=replace_me
# AWS_SECRET_ACCESS_KEY=replace_me
# AWS_DEFAULT_REGION=us-east-1

# External executables
# TRNASCAN_TIMEOUT=900
# TRNASCAN_TIMEOUT_SECONDS=120
