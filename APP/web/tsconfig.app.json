{
  // 继承 Vue 官方的 DOM 配置
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    /* 支持导入 .js 文件 */
    "allowJs": true,
    /* 启用从 node_modules 中解析模块 */
    "moduleResolution": "node",
    /* 项目根路径（用来配合 paths） */
    "baseUrl": ".",
    /* 配置 @/xxx -> src/xxx */
    "paths": {
      "@/*": ["src/*"]
    },

    /* 严格检查选项 */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "src/**/*.ts",
    "env.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.js",
    "src/**/**/*.js",
    "src/**/**/*.ts",
    "src/**/**/**/*.ts",
    "src/**/**/*.tsx",
    "src/router/index.ts"
  ]
}
